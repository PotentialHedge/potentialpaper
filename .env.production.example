# Production keys, no values. Copy to .env.production on the host and fill it. Never committed.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

NODE_ENV=production
# The host name Traefik routes, and the same origin with https:// for the two below.
APP_HOST=
APP_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

RESEND_API_KEY=
MAIL_FROM=

ADMIN_EMAILS=

# Demos: the host Traefik routes to them. Its origin is built into the app as NEXT_PUBLIC_DEMO_ORIGIN
# (lib/demos.ts), which defaults to https://papers-content.potentialhedge.com.
DEMO_HOST=
# R2, where demo files are stored by hash, as PDFs are. Without these, the app stores them on its own disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: a token limited to cache purge on the zone, so an edit drops the edge's copy of its page.
CLOUDFLARE_PURGE_TOKEN=
CLOUDFLARE_ZONE_ID=
