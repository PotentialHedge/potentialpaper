# Production keys, no values. Copy to .env.production on the host and fill it. Never committed.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

NODE_ENV=production
# The host name Traefik routes, and the same origin with https:// for the two below.
APP_HOST=
APP_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

RESEND_API_KEY=
MAIL_FROM=

ADMIN_EMAILS=

# User content (demos and the web editor's webviews), a host each under its own domain: built into the app as
# NEXT_PUBLIC_CONTENT_ORIGIN (lib/demos.ts), default https://ppusercontent.com. Traefik routes the subdomains of
# CONTENT_HOST_PATTERN, the same domain as a regular expression (default ppusercontent\.com). Set both or neither.
CONTENT_HOST_PATTERN=
# R2, where demo files are stored by hash, as PDFs are. Without these, the app stores them on its own disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: a token limited to cache purge on the zone, so an edit drops the edge's copy of its page.
CLOUDFLARE_PURGE_TOKEN=
CLOUDFLARE_ZONE_ID=

# Git over SSH: how clone addresses are written on the profile page (DEPLOY.md, "Git over SSH"), e.g.
# ssh://git@git.papers.potentialhedge.com:2222. The ssh service's port, key file and APP_INTERNAL_URL are set in
# docker-compose.prod.yml; GIT_SSH_PUBLISH (default 2222) is the host port it is published on.
GIT_SSH_URL=
GIT_SSH_PUBLISH=
