{
  "name": "potentialpaper",
  "displayName": "potentialpaper",
  "description": "potentialpaper page repos in VS Code: a preview of each section as the page shows it, a PDF viewer, checked JSON files, and, in the browser, commits to the site.",
  "publisher": "potentialpaper",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.145.0"
  },
  "enabledApiProposals": [
    "scmActionButton"
  ],
  "browser": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:potentialpaper",
    "onStartupFinished",
    "onCustomEditor:potentialpaper.pdf",
    "workspaceContains:prek.toml",
    "onView:potentialpaper.page"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Previews are made by the site, which needs the address in the repo's git remote."
    }
  },
  "contributes": {
    "configuration": {
      "title": "potentialpaper",
      "properties": {
        "potentialpaper.paper": {
          "type": "object",
          "default": null,
          "description": "The paper this editor opened (set by the site)."
        },
        "potentialpaper.origin": {
          "type": "string",
          "default": "",
          "description": "The site's address, such as https://potentialpaper.com. Set by the site in the browser; on the desktop it is read from the clone's git remote, and this overrides it."
        },
        "potentialpaper.webviews": {
          "type": "boolean",
          "default": true,
          "description": "Whether previews and the PDF viewer can open (set by the site in the browser, which turns them off where it has no address for them)."
        },
        "potentialpaper.previewOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open the preview beside the first section opened."
        },
        "potentialpaper.checks": {
          "type": "boolean",
          "default": true,
          "description": "In the browser, run the page's prek.toml checks before each commit, as prek does in a clone (there is no terminal to run it in): files formatted and whitespace fixed, and no commit while a file has an error. The site checks every commit again."
        }
      }
    },
    "commands": [
      {
        "command": "potentialpaper.commit",
        "title": "Commit to the Page",
        "category": "potentialpaper",
        "icon": "$(check)"
      },
      {
        "command": "potentialpaper.refresh",
        "title": "Load the Page's Latest Version",
        "category": "potentialpaper",
        "icon": "$(refresh)"
      },
      {
        "command": "potentialpaper.discard",
        "title": "Discard Change",
        "category": "potentialpaper",
        "icon": "$(discard)"
      },
      {
        "command": "potentialpaper.discardAll",
        "title": "Discard All Changes",
        "category": "potentialpaper",
        "icon": "$(discard)"
      },
      {
        "command": "potentialpaper.openChange",
        "title": "Open Change",
        "category": "potentialpaper"
      },
      {
        "command": "potentialpaper.openPage",
        "title": "Open the Paper's Page",
        "category": "potentialpaper",
        "icon": "$(link-external)"
      },
      {
        "command": "potentialpaper.newSection",
        "title": "New Section",
        "category": "potentialpaper"
      },
      {
        "command": "potentialpaper.nothing",
        "title": "Nothing",
        "category": "potentialpaper"
      },
      {
        "command": "potentialpaper.showPreview",
        "title": "Open Page Preview to the Side",
        "category": "potentialpaper",
        "icon": "$(open-preview)"
      },
      {
        "command": "potentialpaper.newLink",
        "title": "New Link",
        "category": "potentialpaper",
        "icon": "$(add)"
      },
      {
        "command": "potentialpaper.addPicture",
        "title": "Add a Picture",
        "category": "potentialpaper"
      },
      {
        "command": "potentialpaper.runChecks",
        "title": "Run the Page's Checks (prek)",
        "category": "potentialpaper",
        "icon": "$(checklist)"
      },
      {
        "command": "potentialpaper.signIn",
        "title": "Sign In for Previews",
        "category": "potentialpaper"
      },
      {
        "command": "potentialpaper.signOut",
        "title": "Sign Out",
        "category": "potentialpaper"
      },
      {
        "command": "potentialpaper.pdfZoomIn",
        "title": "Zoom In",
        "category": "potentialpaper",
        "icon": "$(zoom-in)"
      },
      {
        "command": "potentialpaper.pdfZoomOut",
        "title": "Zoom Out",
        "category": "potentialpaper",
        "icon": "$(zoom-out)"
      },
      {
        "command": "potentialpaper.pdfFitWidth",
        "title": "Fit to Width",
        "category": "potentialpaper",
        "icon": "$(screen-full)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "potentialpaper.commit",
          "group": "navigation",
          "when": "scmProvider == potentialpaper"
        },
        {
          "command": "potentialpaper.refresh",
          "group": "navigation",
          "when": "scmProvider == potentialpaper"
        },
        {
          "command": "potentialpaper.openPage",
          "group": "navigation",
          "when": "scmProvider == potentialpaper"
        },
        {
          "command": "potentialpaper.discardAll",
          "when": "scmProvider == potentialpaper"
        },
        {
          "command": "potentialpaper.runChecks",
          "when": "scmProvider == potentialpaper"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "potentialpaper.discard",
          "group": "inline",
          "when": "scmProvider == potentialpaper"
        }
      ],
      "commandPalette": [
        {
          "command": "potentialpaper.discard",
          "when": "false"
        },
        {
          "command": "potentialpaper.openChange",
          "when": "false"
        },
        {
          "command": "potentialpaper.nothing",
          "when": "false"
        },
        {
          "command": "potentialpaper.showPreview",
          "when": "potentialpaper.section && potentialpaper.webviews"
        },
        {
          "command": "potentialpaper.pdfZoomIn",
          "when": "activeCustomEditorId == potentialpaper.pdf"
        },
        {
          "command": "potentialpaper.pdfZoomOut",
          "when": "activeCustomEditorId == potentialpaper.pdf"
        },
        {
          "command": "potentialpaper.pdfFitWidth",
          "when": "activeCustomEditorId == potentialpaper.pdf"
        },
        {
          "command": "potentialpaper.signIn",
          "when": "!potentialpaper.inBrowser"
        },
        {
          "command": "potentialpaper.signOut",
          "when": "!potentialpaper.inBrowser"
        },
        {
          "command": "potentialpaper.commit",
          "when": "potentialpaper.inBrowser"
        },
        {
          "command": "potentialpaper.refresh",
          "when": "potentialpaper.inBrowser"
        },
        {
          "command": "potentialpaper.discardAll",
          "when": "potentialpaper.inBrowser"
        },
        {
          "command": "potentialpaper.openPage",
          "when": "potentialpaper.inBrowser"
        },
        {
          "command": "potentialpaper.newSection",
          "when": "potentialpaper.inBrowser"
        },
        {
          "command": "potentialpaper.runChecks",
          "when": "potentialpaper.inBrowser"
        },
        {
          "command": "potentialpaper.addPicture",
          "when": "potentialpaper.pageRepo"
        },
        {
          "command": "potentialpaper.newLink",
          "when": "potentialpaper.pageRepo"
        }
      ],
      "explorer/context": [
        {
          "command": "potentialpaper.newSection",
          "when": "resourceScheme == potentialpaper && explorerResourceIsFolder"
        },
        {
          "command": "potentialpaper.newLink",
          "when": "potentialpaper.pageRepo && explorerResourceIsFolder"
        }
      ],
      "editor/title": [
        {
          "command": "potentialpaper.showPreview",
          "group": "navigation",
          "when": "potentialpaper.section && potentialpaper.webviews"
        },
        {
          "command": "potentialpaper.pdfZoomOut",
          "group": "navigation@1",
          "when": "activeCustomEditorId == potentialpaper.pdf"
        },
        {
          "command": "potentialpaper.pdfZoomIn",
          "group": "navigation@2",
          "when": "activeCustomEditorId == potentialpaper.pdf"
        },
        {
          "command": "potentialpaper.pdfFitWidth",
          "group": "navigation@3",
          "when": "activeCustomEditorId == potentialpaper.pdf"
        }
      ],
      "view/title": [
        {
          "command": "potentialpaper.newLink",
          "group": "navigation",
          "when": "view == potentialpaper.page"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "command": "potentialpaper.showPreview",
        "when": "potentialpaper.section && potentialpaper.webviews"
      },
      {
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "command": "potentialpaper.showPreview",
        "when": "potentialpaper.section && potentialpaper.webviews"
      },
      {
        "key": "ctrl+=",
        "mac": "cmd+=",
        "command": "potentialpaper.pdfZoomIn",
        "when": "activeCustomEditorId == potentialpaper.pdf"
      },
      {
        "key": "ctrl+-",
        "mac": "cmd+-",
        "command": "potentialpaper.pdfZoomOut",
        "when": "activeCustomEditorId == potentialpaper.pdf"
      },
      {
        "key": "ctrl+`",
        "command": "potentialpaper.nothing",
        "when": "potentialpaper.inBrowser"
      },
      {
        "key": "ctrl+shift+`",
        "command": "potentialpaper.nothing",
        "when": "potentialpaper.inBrowser"
      },
      {
        "key": "ctrl+shift+d",
        "command": "potentialpaper.nothing",
        "mac": "cmd+shift+d",
        "when": "potentialpaper.inBrowser"
      },
      {
        "key": "f5",
        "command": "potentialpaper.nothing",
        "when": "potentialpaper.inBrowser"
      },
      {
        "key": "ctrl+f5",
        "command": "potentialpaper.nothing",
        "when": "potentialpaper.inBrowser"
      },
      {
        "key": "shift+f5",
        "command": "potentialpaper.nothing",
        "when": "potentialpaper.inBrowser"
      },
      {
        "key": "ctrl+shift+y",
        "command": "potentialpaper.nothing",
        "mac": "cmd+shift+y",
        "when": "potentialpaper.inBrowser"
      },
      {
        "key": "ctrl+shift+x",
        "command": "potentialpaper.nothing",
        "mac": "cmd+shift+x",
        "when": "potentialpaper.inBrowser"
      },
      {
        "key": "ctrl+shift+c",
        "command": "potentialpaper.nothing",
        "mac": "cmd+shift+c",
        "when": "potentialpaper.inBrowser"
      }
    ],
    "customEditors": [
      {
        "viewType": "potentialpaper.pdf",
        "displayName": "PDF",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "potentialpaper.page",
          "name": "Page",
          "when": "potentialpaper.pageRepo",
          "icon": "$(book)"
        }
      ]
    }
  },
  "main": "./dist/extension.js"
}
