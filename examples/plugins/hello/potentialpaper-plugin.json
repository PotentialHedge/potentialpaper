{
  "id": "potentialhedge/hello",
  "name": "Hello",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "The smallest useful plugin: reads its context and a setting, counts your visits in its storage, and reads the page.",
  "author": "PotentialPaper",
  "main": "index.html",
  "permissions": ["page.read"],
  "contributes": {
    "panels": [
      {
        "id": "hello",
        "title": "Hello",
        "kinds": ["paper", "venue", "topic", "org", "user"],
        "slot": { "paper": "aside", "*": "main" }
      }
    ],
    "pages": [{ "id": "about", "title": "About Hello" }],
    "settings": {
      "greeting": {
        "type": "string",
        "default": "Hello",
        "maxLength": 40,
        "description": "What the panel says first."
      },
      "showScopes": { "type": "boolean", "default": true, "description": "List the pages above this one." }
    },
    "commands": [{ "id": "reset", "title": "Reset the visit count" }]
  }
}
