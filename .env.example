# Dev environment. Copy to .env and adjust. Never commit a filled file.
DATABASE_URL=postgres://potentialpaper:potentialpaper@127.0.0.1:55433/potentialpaper
# Used by the integration tests, which TRUNCATE every table.
TEST_DATABASE_URL=postgres://potentialpaper:potentialpaper@127.0.0.1:55433/potentialpaper_test

# This app's public origin. Any long random string for the secret: `openssl rand -base64 32`.
BETTER_AUTH_URL=http://localhost:3000
# The origin in absolute links (mail). Defaults to BETTER_AUTH_URL.
APP_URL=
BETTER_AUTH_SECRET=

# Without RESEND_API_KEY, dev mail is printed to the server log instead of sent.
RESEND_API_KEY=
MAIL_FROM=

# Signed-in users with these emails (comma-separated) are admins.
ADMIN_EMAILS=

# Optional overrides of the generated files in config/.
INSTITUTION_DOMAINS_PATH=

# Rate limit per signed-in account: bucket size, refill per second.
API_RATE_LIMIT_BURST=60
API_RATE_LIMIT_PER_SECOND=2
